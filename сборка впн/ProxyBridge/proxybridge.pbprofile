{
  "Version": "1.0",
  "Name": "my",
  "LocalhostViaProxy": false,
  "IsTrafficLoggingEnabled": true,
  "AutoClearConnectionLogs": true,
  "Language": "en",
  "CloseToTray": true,
  "ProxyConfigs": [
    {
      "Id": 1,
      "Type": "SOCKS5",
      "Host": "127.0.0.1",
      "Port": "2080",
      "Username": "",
      "Password": ""
    }
  ],
  "ProxyRules": [
    {
      "ProcessName": "*",
      "TargetHosts": "localhost; 127.0.0.1; %ComputerName%; ::1; 192.168.1.*",
      "TargetPorts": "*",
      "Protocol": "BOTH",
      "Action": "DIRECT",
      "IsEnabled": true,
      "ProxyConfigId": 0
    },
    {
      "ProcessName": "Discord.exe;",
      "TargetHosts": "*",
      "TargetPorts": "*",
      "Protocol": "UDP",
      "Action": "PROXY",
      "IsEnabled": true,
      "ProxyConfigId": 1
    },
    {
      "ProcessName": "Discord.exe;",
      "TargetHosts": "*",
      "TargetPorts": "19294-19344; 50000-65000",
      "Protocol": "UDP",
      "Action": "PROXY",
      "IsEnabled": true,
      "ProxyConfigId": 1
    },
    {
      "ProcessName": "Telegram.exe; ",
      "TargetHosts": "*",
      "TargetPorts": "*",
      "Protocol": "UDP",
      "Action": "PROXY",
      "IsEnabled": true,
      "ProxyConfigId": 1
    },
    {
      "ProcessName": "*",
      "TargetHosts": "*",
      "TargetPorts": "*",
      "Protocol": "BOTH",
      "Action": "DIRECT",
      "IsEnabled": true,
      "ProxyConfigId": 0
    }
  ],
  "LogFilters": [
    {
      "Mode": "Include",
      "ProcessName": "",
      "Ip": "",
      "Port": "",
      "Protocol": "All",
      "Action": "Proxy"
    }
  ]
}